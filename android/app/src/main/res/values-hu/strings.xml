    <string name="create_phrase_title">A helyreállítási kifejezésed</string>
    <string name="create_phrase_body">Írd le ezt a(z) %1$d szót papírra, offline. Aki birtokolja őket, az irányítja a pénzedet.</string>
    <string name="create_passphrase_hint">Egy „25. szó” — egy extra titok, amit nem tárolunk. Ha beállítasz egyet, a visszaállításhoz szükséged van a kifejezésre és erre is. Hagyd üresen, ha bizonytalan vagy.</string>
    <string name="create_ack">Leírtam a kifejezést</string>

