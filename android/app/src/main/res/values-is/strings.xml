    <string name="gen_title">Bættu við smá tilviljun</string>
    <string name="gen_body">Síminn þinn bjó þegar til öruggt fræ. Hristu hann — eða krotaðu á svæðið — til að blanda inn auka óreiðu frá hreyfiskynjurunum og tímaflökti. Til öryggis.</string>
    <string name="gen_words_24">24 orð</string>
    <string name="gen_words_12">12 orð</string>
    <string name="gen_words_hint">Bæði eru örugg; auðveldara er að skrifa niður 12.</string>
    <string name="gen_pad_hint">hristu, eða krotaðu hér</string>
    <string name="gen_entropy_full">nóg af auka óreiðu — grunnfræið er þegar öruggt</string>
    <string name="gen_entropy_partial">~%1$d auka bitum blandað inn</string>
    <string name="gen_generate">Búa til veski</string>

    <string name="create_phrase_title">Endurheimtarsetningin þín</string>
    <string name="create_phrase_body">Skrifaðu þessi %1$d orð á pappír, án nettengingar. Hver sem hefur þau ræður yfir fé þínu.</string>
    <string name="create_passphrase_hint">\"25. orð\" — auka leyndarmál sem er ekki vistað. Ef þú setur eitt þarftu bæði setninguna og það til að endurheimta. Hafðu autt ef þú ert í vafa.</string>
    <string name="create_ack">Ég hef skrifað setninguna niður</string>

    <string name="restore_title">Endurheimta veski</string>
    <string name="restore_body">Sláðu inn 12 eða 24 orðin þín, aðskilin með bilum.</string>
    <string name="restore_clone_hint">Eftir að því er bætt við geturðu líka skráð þetta veski á %1$s í Stjórna veskjum — sama setning, sömu vistföng.</string>
    <string name="action_restore">Endurheimta</string>

