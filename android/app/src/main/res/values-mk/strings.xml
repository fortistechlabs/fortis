    <string name="gen_title">Додајте малку случајност</string>
    <string name="gen_body">Вашиот телефон веќе создаде безбеден seed. Протресете го — или чкртајте по полето — за да измешате дополнителна ентропија од сензорите за движење и временските отстапувања. За секој случај.</string>
    <string name="gen_words_24">24 зборови</string>
    <string name="gen_words_12">12 зборови</string>
    <string name="gen_words_hint">И двата се безбедни; 12 полесно се запишуваат.</string>
    <string name="gen_pad_hint">протресете или чкртајте тука</string>
    <string name="gen_entropy_full">многу дополнителна ентропија — основниот seed е веќе безбеден</string>
    <string name="gen_entropy_partial">измешани ~%1$d дополнителни бита</string>
    <string name="gen_generate">Создај паричник</string>

    <string name="create_phrase_title">Вашата фраза за обновување</string>
    <string name="create_phrase_body">Запишете ги овие %1$d зборови на хартија, офлајн. Секој што ги има управува со вашите средства.</string>
    <string name="create_passphrase_hint">„25-ти збор“ — дополнителна тајна што не се складира. Ако поставите една, за обновување ви требаат и фразата и таа. Оставете празно ако не сте сигурни.</string>
    <string name="create_ack">Ја запишав фразата</string>

    <string name="restore_title">Обнови паричник</string>
    <string name="restore_body">Внесете ги вашите 12 или 24 зборови, одделени со празни места.</string>
    <string name="restore_clone_hint">Откако ќе се додаде, овој паричник можете да го наведете и на %1$s преку „Управување со паричници“ — иста фраза, исти адреси.</string>
    <string name="action_restore">Обнови</string>

