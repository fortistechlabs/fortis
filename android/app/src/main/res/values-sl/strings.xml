    <string name="gen_title">Dodajte nekaj naključja</string>
    <string name="gen_body">Vaš telefon je že ustvaril varno seme. Stresite ga — ali čečkajte po polju — da primešate dodatno entropijo iz senzorjev gibanja in časovnih nihanj. Za vsak primer.</string>
    <string name="gen_words_24">24 besed</string>
    <string name="gen_words_12">12 besed</string>
    <string name="gen_words_hint">Obe sta varni; 12 je lažje zapisati.</string>
    <string name="gen_pad_hint">stresite ali čečkajte tukaj</string>
    <string name="gen_entropy_full">obilo dodatne entropije — osnovno seme je že varno</string>
    <string name="gen_entropy_partial">primešanih ~%1$d dodatnih bitov</string>
    <string name="gen_generate">Ustvari denarnico</string>

    <string name="create_phrase_title">Vaša obnovitvena fraza</string>
    <string name="create_phrase_body">Teh %1$d besed zapišite na papir, brez povezave. Kdor koli, ki jih ima, nadzoruje vaša sredstva.</string>
    <string name="create_passphrase_hint">»25. beseda« — dodatna skrivnost, ki se ne shrani. Če jo nastavite, za obnovitev potrebujete tako frazo kot to. Če niste prepričani, pustite prazno.</string>
    <string name="create_ack">Frazo sem zapisal(-a)</string>

    <string name="restore_title">Obnovi denarnico</string>
    <string name="restore_body">Vnesite svojih 12 ali 24 besed, ločenih s presledki.</string>
    <string name="restore_clone_hint">Ko je dodana, lahko to denarnico navedete tudi na %1$s v razdelku Upravljanje denarnic — ista fraza, isti naslovi.</string>
    <string name="action_restore">Obnovi</string>

