    <string name="gen_title">Pridajte trochu náhody</string>
    <string name="gen_body">Váš telefón už vygeneroval bezpečný seed. Potraste ním — alebo čmárajte po ploche — a primiešajte tak ďalšiu entropiu z pohybových senzorov a časového kolísania. Pre istotu.</string>
    <string name="gen_words_24">24 slov</string>
    <string name="gen_words_12">12 slov</string>
    <string name="gen_words_hint">Obe sú bezpečné; 12 sa ľahšie zapíše.</string>
    <string name="gen_pad_hint">potraste alebo čmárajte tu</string>
    <string name="gen_entropy_full">množstvo ďalšej entropie — základný seed je už bezpečný</string>
    <string name="gen_entropy_partial">primiešaných ~%1$d bitov navyše</string>
    <string name="gen_generate">Vygenerovať peňaženku</string>

    <string name="create_phrase_title">Vaša obnovovacia fráza</string>
    <string name="create_phrase_body">Zapíšte týchto %1$d slov na papier, offline. Ktokoľvek, kto ich má, ovláda vaše prostriedky.</string>
    <string name="create_passphrase_hint">„25. slovo“ — ďalšie tajomstvo, ktoré sa neukladá. Ak ho nastavíte, na obnovu potrebujete frázu aj toto. Ak si nie ste istí, nechajte prázdne.</string>
    <string name="create_ack">Frázu som si zapísal(a)</string>

    <string name="restore_title">Obnoviť peňaženku</string>
    <string name="restore_body">Zadajte svojich 12 alebo 24 slov oddelených medzerami.</string>
    <string name="restore_clone_hint">Po pridaní môžete túto peňaženku uviesť aj na %1$s v časti Správa peňaženiek — rovnaká fráza, rovnaké adresy.</string>
