    <string name="gen_title">Legg til litt tilfeldighet</string>
    <string name="gen_body">Telefonen din har allerede generert et sikkert frø. Rist den — eller rabl på feltet — for å blande inn ekstra entropi fra bevegelsessensorene og tidsvariasjoner. For sikkerhets skyld.</string>
    <string name="gen_words_24">24 ord</string>
    <string name="gen_words_12">12 ord</string>
    <string name="gen_words_hint">Begge er sikre; 12 er lettere å skrive ned.</string>
    <string name="gen_pad_hint">rist, eller rabl her</string>
    <string name="gen_entropy_full">rikelig med ekstra entropi — grunnfrøet er allerede sikkert</string>
    <string name="gen_entropy_partial">~%1$d ekstra bit blandet inn</string>
    <string name="gen_generate">Generer lommebok</string>

    <string name="create_phrase_title">Gjenopprettingsfrasen din</string>
    <string name="create_phrase_body">Skriv disse %1$d ordene ned på papir, frakoblet. Alle som har dem, kontrollerer midlene dine.</string>
    <string name="create_passphrase_hint">Et \"25. ord\" — en ekstra hemmelighet som ikke lagres. Setter du en, trenger du både frasen og denne for å gjenopprette. La stå tomt hvis du er usikker.</string>
    <string name="create_ack">Jeg har skrevet ned frasen</string>

    <string name="restore_title">Gjenopprett lommebok</string>
    <string name="restore_body">Skriv inn de 12 eller 24 ordene dine, atskilt med mellomrom.</string>
    <string name="restore_clone_hint">Etter at den er lagt til, kan du også vise denne lommeboken på %1$s fra Administrer lommebøker — samme frase, samme adresser.</string>
