    <string name="gen_title">Προσθέστε λίγη τυχαιότητα</string>
    <string name="gen_body">Το τηλέφωνό σας δημιούργησε ήδη έναν ασφαλή σπόρο. Κουνήστε το — ή σκαρίφημα στην περιοχή — για να αναμείξετε επιπλέον εντροπία από τους αισθητήρες κίνησης και τις χρονικές διακυμάνσεις. Για κάθε ενδεχόμενο.</string>
    <string name="gen_words_24">24 λέξεις</string>
    <string name="gen_words_12">12 λέξεις</string>
    <string name="gen_words_hint">Και οι δύο είναι ασφαλείς· οι 12 σημειώνονται πιο εύκολα.</string>
    <string name="gen_pad_hint">κουνήστε ή σκαριφήστε εδώ</string>
    <string name="gen_entropy_full">άφθονη επιπλέον εντροπία — ο βασικός σπόρος είναι ήδη ασφαλής</string>
    <string name="gen_entropy_partial">αναμείχθηκαν ~%1$d επιπλέον bit</string>
    <string name="gen_generate">Δημιουργία πορτοφολιού</string>

    <string name="create_phrase_title">Η φράση ανάκτησής σας</string>
    <string name="create_phrase_body">Γράψτε αυτές τις %1$d λέξεις σε χαρτί, εκτός σύνδεσης. Όποιος τις έχει ελέγχει τα χρήματά σας.</string>
    <string name="create_passphrase_hint">Μια «25η λέξη» — ένα επιπλέον μυστικό, που δεν αποθηκεύεται. Αν ορίσετε μία, χρειάζεστε και τη φράση και αυτήν για επαναφορά. Αφήστε το κενό αν δεν είστε σίγουροι.</string>
    <string name="create_ack">Έγραψα τη φράση</string>

    <string name="restore_title">Επαναφορά πορτοφολιού</string>
    <string name="restore_body">Εισαγάγετε τις 12 ή 24 λέξεις σας, χωρισμένες με κενά.</string>
    <string name="restore_clone_hint">Αφού προστεθεί, μπορείτε επίσης να καταχωρίσετε αυτό το πορτοφόλι στο %1$s από τη Διαχείριση πορτοφολιών — ίδια φράση, ίδιες διευθύνσεις.</string>
