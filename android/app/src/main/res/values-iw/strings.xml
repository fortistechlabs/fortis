    <string name="dialog_reveal_title">להציג את ביטוי השחזור של %1$s?</string>
    <string name="dialog_reveal_body">ביטוי השחזור (וביטוי הסיסמה, אם הגדרתם אחד) הוא הדבר היחיד שיכול לשחזר את הארנק הזה — וכל מי שיש לו אותו יכול להוציא את הכספים שלכם. חשפו אותו רק במקום פרטי, כשאף אחד לא מסתכל. המסך הבא חוסם צילומי מסך.</string>
    <string name="dialog_remove_title">להסיר את %1$s?</string>
    <string name="dialog_remove_body">פעולה זו מסירה את הארנק מהאפליקציה הזו בלבד. שום דבר לא משתנה בבלוקצ׳יין, ותוכלו להוסיף אותו בחזרה בכל עת עם ביטוי השחזור שלו (וביטוי הסיסמה, אם הגדרתם אחד). ודאו שהביטוי רשום.</string>

