    <string name="gen_title">הוסיפו קצת אקראיות</string>
    <string name="gen_body">הטלפון שלכם כבר יצר זרע מאובטח. נערו אותו — או שרבטו על המשטח — כדי לערבב אנטרופיה נוספת מחיישני התנועה ומתנודות התזמון. ליתר ביטחון.</string>
    <string name="gen_words_24">24 מילים</string>
    <string name="gen_words_12">12 מילים</string>
    <string name="gen_words_hint">שתי האפשרויות מאובטחות; קל יותר לרשום 12.</string>
    <string name="gen_pad_hint">נערו, או שרבטו כאן</string>
    <string name="gen_entropy_full">שפע של אנטרופיה נוספת — הזרע הבסיסי כבר מאובטח</string>
    <string name="gen_entropy_partial">עורבבו ~%1$d ביטים נוספים</string>
    <string name="gen_generate">יצירת ארנק</string>

    <string name="create_phrase_title">ביטוי השחזור שלכם</string>
    <string name="create_phrase_body">כתבו את %1$d המילים האלה על נייר, לא מקוון. כל מי שיש לו אותן שולט בכספים שלכם.</string>
    <string name="create_passphrase_hint">‏«מילה 25» — סוד נוסף שאינו נשמר. אם תגדירו אחד, לשחזור צריך גם את הביטוי וגם אותו. השאירו ריק אם אינכם בטוחים.</string>
    <string name="create_ack">רשמתי את הביטוי</string>

    <string name="restore_title">שחזור ארנק</string>
    <string name="restore_body">הזינו את 12 או 24 המילים שלכם, מופרדות ברווחים.</string>
    <string name="restore_clone_hint">לאחר ההוספה תוכלו לרשום את הארנק הזה גם ב-%1$s דרך «ניהול ארנקים» — אותו ביטוי, אותן כתובות.</string>
