    <string name="gen_title">Bir az təsadüfilik əlavə edin</string>
    <string name="gen_body">Telefonunuz artıq təhlükəsiz toxum yaradıb. Hərəkət sensorlarından və zamanlama titrəyişindən əlavə entropiya qarışdırmaq üçün telefonu silkələyin — ya da sahədə cızma-qara edin. Hər ehtimala qarşı.</string>
    <string name="gen_words_24">24 söz</string>
    <string name="gen_words_12">12 söz</string>
    <string name="gen_words_hint">Hər ikisi təhlükəsizdir; 12 sözü yazmaq daha asandır.</string>
    <string name="gen_pad_hint">silkələyin və ya burada cızma-qara edin</string>
    <string name="gen_entropy_full">kifayət qədər əlavə entropiya — əsas toxum artıq təhlükəsizdir</string>
    <string name="gen_entropy_partial">~%1$d əlavə bit qarışdırıldı</string>
    <string name="gen_generate">Pulqabı yarat</string>

    <string name="create_phrase_title">Sizin bərpa ifadəniz</string>
    <string name="create_phrase_body">Bu %1$d sözü kağıza, oflayn yazın. Onlara sahib olan hər kəs vəsaitlərinizə nəzarət edir.</string>
    <string name="create_passphrase_hint">\"25-ci söz\" — saxlanılmayan əlavə sirr. Onu təyin etsəniz, bərpa üçün həm ifadə, həm də bu lazımdır. Əmin deyilsinizsə, boş buraxın.</string>
    <string name="create_ack">İfadəni yazdım</string>

    <string name="restore_title">Pulqabını bərpa et</string>
