    <string name="gen_title">Додайте трохи випадковості</string>
    <string name="gen_body">Ваш телефон уже згенерував надійний сід. Потрусіть його — або помалюйте на полі — щоб додати додаткову ентропію з датчиків руху та часових коливань. Про всяк випадок.</string>
    <string name="gen_words_24">24 слова</string>
    <string name="gen_words_12">12 слів</string>
    <string name="gen_words_hint">Обидва варіанти безпечні; 12 легше записати.</string>
    <string name="gen_pad_hint">потрусіть або помалюйте тут</string>
    <string name="gen_entropy_full">достатньо додаткової ентропії — базовий сід уже надійний</string>
    <string name="gen_entropy_partial">додано ~%1$d додаткових біт</string>
    <string name="gen_generate">Згенерувати гаманець</string>

    <string name="create_phrase_title">Ваша фраза відновлення</string>
    <string name="create_phrase_body">Запишіть ці %1$d слів на папері, офлайн. Той, хто їх має, розпоряджається вашими коштами.</string>
    <string name="create_passphrase_hint">«25-те слово» — додатковий секрет, який не зберігається. Якщо його встановити, для відновлення знадобляться і фраза, і воно. Залиште порожнім, якщо не впевнені.</string>
    <string name="create_ack">Я записав(-ла) фразу</string>

    <string name="restore_title">Відновити гаманець</string>
    <string name="restore_body">Введіть 12 або 24 слова через пробіл.</string>
    <string name="restore_clone_hint">Після додавання ви також можете завести цей гаманець у %1$s через «Керування гаманцями» — та сама фраза, ті самі адреси.</string>
    <string name="action_restore">Відновити</string>

