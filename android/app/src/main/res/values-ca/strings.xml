    <string name="gen_title">Afegeix una mica d\'aleatorietat</string>
    <string name="gen_body">El teu telèfon ja ha generat una llavor segura. Sacseja\'l — o gargoteja al plafó — per barrejar-hi entropia extra dels sensors de moviment i les variacions de temps. Per si de cas.</string>
    <string name="gen_words_24">24 paraules</string>
    <string name="gen_words_12">12 paraules</string>
    <string name="gen_words_hint">Totes dues són segures; 12 és més fàcil d\'anotar.</string>
    <string name="gen_pad_hint">sacseja o gargoteja aquí</string>
    <string name="gen_entropy_full">molta entropia extra — la llavor base ja és segura</string>
    <string name="gen_entropy_partial">~%1$d bits extra barrejats</string>
    <string name="gen_generate">Genera la cartera</string>

    <string name="create_phrase_title">La teva frase de recuperació</string>
    <string name="create_phrase_body">Escriu aquestes %1$d paraules en paper, sense connexió. Qui les tingui controla els teus fons.</string>
    <string name="create_passphrase_hint">Una \"25a paraula\" — un secret addicional, que no es desa. Si en poses una, necessites tant la frase com això per restaurar. Deixa-ho en blanc si no n\'estàs segur.</string>
    <string name="create_ack">He anotat la frase</string>

    <string name="restore_title">Restaura la cartera</string>
    <string name="restore_body">Introdueix les teves 12 o 24 paraules, separades per espais.</string>
    <string name="restore_clone_hint">Un cop afegida, també pots llistar aquesta cartera a %1$s des de Gestiona carteres — la mateixa frase, les mateixes adreces.</string>
    <string name="action_restore">Restaura</string>

