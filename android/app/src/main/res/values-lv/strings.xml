    <string name="gen_title">Pievienojiet nedaudz nejaušības</string>
    <string name="gen_body">Jūsu tālrunis jau ir izveidojis drošu sēklu. Pakratiet to — vai zīmējiet uz laukuma — lai piejauktu papildu entropiju no kustību sensoriem un laika svārstībām. Katram gadījumam.</string>
    <string name="gen_words_24">24 vārdi</string>
    <string name="gen_words_12">12 vārdi</string>
    <string name="gen_words_hint">Abas ir drošas; 12 ir vieglāk pierakstīt.</string>
    <string name="gen_pad_hint">pakratiet vai zīmējiet šeit</string>
    <string name="gen_entropy_full">daudz papildu entropijas — pamatsēkla jau ir droša</string>
    <string name="gen_entropy_partial">piejaukti ~%1$d papildu biti</string>
    <string name="gen_generate">Ģenerēt maku</string>

    <string name="create_phrase_title">Jūsu atkopšanas frāze</string>
    <string name="create_phrase_body">Uzrakstiet šos %1$d vārdus uz papīra, bezsaistē. Ikviens, kam tie ir, kontrolē jūsu līdzekļus.</string>
    <string name="create_passphrase_hint">„25. vārds” — papildu noslēpums, kas netiek saglabāts. Ja to iestatāt, atjaunošanai nepieciešama gan frāze, gan tas. Ja neesat pārliecināts, atstājiet tukšu.</string>
    <string name="create_ack">Esmu pierakstījis frāzi</string>

    <string name="restore_title">Atjaunot maku</string>
    <string name="restore_body">Ievadiet savus 12 vai 24 vārdus, atdalītus ar atstarpēm.</string>
    <string name="restore_clone_hint">Pēc pievienošanas šo maku varat iekļaut arī pakalpojumā %1$s sadaļā „Pārvaldīt makus” — tā pati frāze, tās pašas adreses.</string>
    <string name="action_restore">Atjaunot</string>

