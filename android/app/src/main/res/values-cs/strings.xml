    <string name="gen_title">Přidejte trochu náhody</string>
    <string name="gen_body">Váš telefon už vygeneroval bezpečný seed. Zatřeste s ním — nebo čmárejte po ploše — a přimíchejte tak další entropii z pohybových senzorů a časového kolísání. Pro jistotu.</string>
    <string name="gen_words_24">24 slov</string>
    <string name="gen_words_12">12 slov</string>
    <string name="gen_words_hint">Obě jsou bezpečné; 12 se snáz zapíše.</string>
    <string name="gen_pad_hint">zatřeste nebo čmárejte zde</string>
    <string name="gen_entropy_full">spousta další entropie — základní seed je už bezpečný</string>
    <string name="gen_entropy_partial">přimícháno ~%1$d bitů navíc</string>
    <string name="gen_generate">Vygenerovat peněženku</string>

    <string name="create_phrase_title">Vaše obnovovací fráze</string>
    <string name="create_phrase_body">Zapište těchto %1$d slov na papír, offline. Kdokoli, kdo je má, ovládá vaše prostředky.</string>
    <string name="create_passphrase_hint">„25. slovo“ — další tajemství, které se neukládá. Pokud ho nastavíte, k obnově potřebujete frázi i toto. Pokud si nejste jisti, nechte prázdné.</string>
    <string name="create_ack">Frázi jsem si zapsal(a)</string>

    <string name="restore_title">Obnovit peněženku</string>
    <string name="restore_body">Zadejte svých 12 nebo 24 slov oddělených mezerami.</string>
    <string name="restore_clone_hint">Po přidání můžete tuto peněženku uvést i na %1$s v části Správa peněženek — stejná fráze, stejné adresy.</string>
