    <string name="gen_title">Dodaj trochę losowości</string>
    <string name="gen_body">Twój telefon już wygenerował bezpieczny seed. Potrząśnij nim — albo bazgraj po polu — aby domieszać dodatkową entropię z czujników ruchu i wahań czasu. Na wszelki wypadek.</string>
    <string name="gen_words_24">24 słowa</string>
    <string name="gen_words_12">12 słów</string>
    <string name="gen_words_hint">Oba są bezpieczne; 12 łatwiej zapisać.</string>
    <string name="gen_pad_hint">potrząśnij lub bazgraj tutaj</string>
    <string name="gen_entropy_full">mnóstwo dodatkowej entropii — bazowy seed jest już bezpieczny</string>
    <string name="gen_entropy_partial">domieszano ~%1$d dodatkowych bitów</string>
    <string name="gen_generate">Wygeneruj portfel</string>

    <string name="create_phrase_title">Twoja fraza odzyskiwania</string>
    <string name="create_phrase_body">Zapisz te %1$d słów na papierze, offline. Każdy, kto je ma, kontroluje Twoje środki.</string>
    <string name="create_passphrase_hint">„25. słowo” — dodatkowy sekret, który nie jest przechowywany. Jeśli je ustawisz, do przywrócenia potrzebujesz zarówno frazy, jak i tego. Zostaw puste w razie wątpliwości.</string>
    <string name="create_ack">Zapisałem/-am frazę</string>

    <string name="restore_title">Przywróć portfel</string>
    <string name="restore_body">Wpisz 12 lub 24 słów oddzielonych spacjami.</string>
    <string name="restore_clone_hint">Po dodaniu możesz też umieścić ten portfel na %1$s w sekcji Zarządzaj portfelami — ta sama fraza, te same adresy.</string>
    <string name="action_restore">Przywróć</string>

