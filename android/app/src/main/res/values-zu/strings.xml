    <string name="gen_words_12">Amagama angu-12</string>
    <string name="gen_words_hint">Kokubili kuphephile; angu-12 kulula ukuwabhala phansi.</string>
    <string name="gen_pad_hint">yinyakazise, noma udwebe lapha</string>
    <string name="gen_entropy_full">i-entropy eyengeziwe eminingi — imbewu eyisisekelo isivele iphephile</string>
    <string name="gen_entropy_partial">kuhlanganiswe amabhithi angu-~%1$d engeziwe</string>
    <string name="gen_generate">Khiqiza isikhwama</string>

    <string name="create_phrase_title">Umusho wakho wokubuyisela</string>
    <string name="create_phrase_body">Bhala la magama angu-%1$d ephepheni, ungaxhunywe ku-inthanethi. Noma ubani onawo ulawula izimali zakho.</string>
    <string name="create_passphrase_hint">\"Igama lama-25\" — imfihlo eyengeziwe, engagcinwa. Uma ulisetha, udinga umusho nalokhu ukuze ubuyisele. Shiya kungenalutho uma ungaqinisekile.</string>
    <string name="create_ack">Ngiwubhalile umusho</string>

    <string name="restore_title">Buyisela isikhwama</string>
    <string name="restore_body">Faka amagama akho angu-12 noma angu-24, ehlukaniswe ngezikhala.</string>
