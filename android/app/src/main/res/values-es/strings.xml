    <string name="gen_title">Añade algo de aleatoriedad</string>
    <string name="gen_body">Tu teléfono ya generó una semilla segura. Agítalo —o garabatea en el panel— para añadir entropía extra de los sensores de movimiento y de la variación temporal. Por si acaso.</string>
    <string name="gen_words_24">24 palabras</string>
    <string name="gen_words_12">12 palabras</string>
    <string name="gen_words_hint">Ambas son seguras; 12 es más fácil de anotar.</string>
    <string name="gen_pad_hint">agita o garabatea aquí</string>
    <string name="gen_entropy_full">entropía extra de sobra: la semilla base ya es segura</string>
    <string name="gen_entropy_partial">~%1$d bits extra añadidos</string>
