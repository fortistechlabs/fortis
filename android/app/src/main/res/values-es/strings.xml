    <string name="create_phrase_title">Tu frase de recuperación</string>
    <string name="create_phrase_body">Escribe estas %1$d palabras en papel, sin conexión. Quien las tenga controla tus fondos.</string>
    <string name="create_passphrase_hint">Una \"palabra 25\": un secreto adicional que no se guarda. Si defines una, necesitarás tanto la frase como esto para restaurar. Déjalo en blanco si no estás seguro.</string>
    <string name="create_ack">He anotado la frase</string>

    <string name="restore_title">Restaurar monedero</string>
    <string name="restore_body">Introduce tus 12 o 24 palabras separadas por espacios.</string>
    <string name="restore_clone_hint">Una vez añadido, también puedes incluir este monedero en %1$s desde Gestionar monederos: misma frase, mismas direcciones.</string>
    <string name="action_restore">Restaurar</string>

