    <string name="gen_title">Ajoutez un peu d\'aléatoire</string>
    <string name="gen_body">Votre téléphone a déjà généré une graine sûre. Secouez-le — ou gribouillez sur la zone — pour y mêler de l\'entropie supplémentaire issue des capteurs de mouvement et des variations de timing. Ceinture et bretelles.</string>
    <string name="gen_words_24">24 mots</string>
    <string name="gen_words_12">12 mots</string>
    <string name="gen_words_hint">Les deux sont sûrs ; 12 est plus facile à noter.</string>
    <string name="gen_pad_hint">secouez ou gribouillez ici</string>
    <string name="gen_entropy_full">largement assez d\'entropie supplémentaire — la graine de base est déjà sûre</string>
    <string name="gen_entropy_partial">~%1$d bits supplémentaires ajoutés</string>
    <string name="gen_generate">Générer le portefeuille</string>

    <string name="create_phrase_title">Votre phrase de récupération</string>
    <string name="create_phrase_body">Notez ces %1$d mots sur papier, hors ligne. Quiconque les possède contrôle vos fonds.</string>
    <string name="create_passphrase_hint">Un « 25e mot » — un secret supplémentaire, non stocké. Si vous en définissez un, il faudra à la fois la phrase et ceci pour restaurer. Laissez vide en cas de doute.</string>
    <string name="create_ack">J\'ai noté la phrase</string>

    <string name="restore_title">Restaurer le portefeuille</string>
    <string name="restore_body">Saisissez vos 12 ou 24 mots, séparés par des espaces.</string>
    <string name="restore_clone_hint">Une fois ajouté, vous pouvez aussi lister ce portefeuille sur %1$s depuis Gérer les portefeuilles — même phrase, mêmes adresses.</string>
    <string name="action_restore">Restaurer</string>

