    <string name="gen_title">ਕੁਝ ਬੇਤਰਤੀਬੀ ਸ਼ਾਮਲ ਕਰੋ</string>
    <string name="gen_body">ਤੁਹਾਡੇ ਫ਼ੋਨ ਨੇ ਪਹਿਲਾਂ ਹੀ ਇੱਕ ਸੁਰੱਖਿਅਤ ਸੀਡ ਬਣਾ ਲਿਆ ਹੈ। ਮੋਸ਼ਨ ਸੈਂਸਰਾਂ ਅਤੇ ਸਮੇਂ ਦੇ ਉਤਰਾਅ-ਚੜ੍ਹਾਅ ਤੋਂ ਵਾਧੂ ਐਂਟ੍ਰੌਪੀ ਮਿਲਾਉਣ ਲਈ ਇਸਨੂੰ ਹਿਲਾਓ — ਜਾਂ ਪੈਡ ਉੱਤੇ ਲਕੀਰਾਂ ਖਿੱਚੋ। ਸਾਵਧਾਨੀ ਵਜੋਂ।</string>
    <string name="gen_words_24">24 ਸ਼ਬਦ</string>
    <string name="gen_words_12">12 ਸ਼ਬਦ</string>
    <string name="gen_words_hint">ਦੋਵੇਂ ਸੁਰੱਖਿਅਤ ਹਨ; 12 ਲਿਖਣੇ ਸੌਖੇ ਹਨ।</string>
    <string name="gen_pad_hint">ਹਿਲਾਓ, ਜਾਂ ਇੱਥੇ ਲਕੀਰਾਂ ਖਿੱਚੋ</string>
    <string name="gen_entropy_full">ਬਹੁਤ ਸਾਰੀ ਵਾਧੂ ਐਂਟ੍ਰੌਪੀ — ਮੂਲ ਸੀਡ ਪਹਿਲਾਂ ਹੀ ਸੁਰੱਖਿਅਤ ਹੈ</string>
    <string name="gen_entropy_partial">~%1$d ਵਾਧੂ ਬਿੱਟ ਮਿਲਾਏ ਗਏ</string>
    <string name="gen_generate">ਵਾਲਿਟ ਬਣਾਓ</string>

    <string name="create_phrase_title">ਤੁਹਾਡਾ ਰਿਕਵਰੀ ਵਾਕੰਸ਼</string>
    <string name="create_phrase_body">ਇਹ %1$d ਸ਼ਬਦ ਕਾਗਜ਼ ਉੱਤੇ, ਆਫ਼ਲਾਈਨ ਲਿਖੋ। ਜਿਸ ਕੋਲ ਇਹ ਹਨ ਉਹ ਤੁਹਾਡੇ ਫੰਡਾਂ ਨੂੰ ਕੰਟਰੋਲ ਕਰਦਾ ਹੈ।</string>
    <string name="create_passphrase_hint">ਇੱਕ «25ਵਾਂ ਸ਼ਬਦ» — ਇੱਕ ਵਾਧੂ ਗੁਪਤ, ਜੋ ਸਟੋਰ ਨਹੀਂ ਹੁੰਦਾ। ਜੇ ਤੁਸੀਂ ਸੈੱਟ ਕਰਦੇ ਹੋ ਤਾਂ ਰੀਸਟੋਰ ਲਈ ਵਾਕੰਸ਼ ਅਤੇ ਇਹ ਦੋਵੇਂ ਲੋੜੀਂਦੇ ਹਨ। ਸ਼ੱਕ ਹੋਵੇ ਤਾਂ ਖਾਲੀ ਛੱਡੋ।</string>
    <string name="create_ack">ਮੈਂ ਵਾਕੰਸ਼ ਲਿਖ ਲਿਆ ਹੈ</string>

    <string name="restore_title">ਵਾਲਿਟ ਰੀਸਟੋਰ ਕਰੋ</string>
    <string name="restore_body">ਆਪਣੇ 12 ਜਾਂ 24 ਸ਼ਬਦ, ਸਪੇਸ ਨਾਲ ਵੱਖ ਕਰਕੇ ਦਾਖਲ ਕਰੋ।</string>
    <string name="restore_clone_hint">ਸ਼ਾਮਲ ਕਰਨ ਤੋਂ ਬਾਅਦ ਤੁਸੀਂ «ਵਾਲਿਟ ਪ੍ਰਬੰਧਿਤ ਕਰੋ» ਤੋਂ ਇਸ ਵਾਲਿਟ ਨੂੰ %1$s ਉੱਤੇ ਵੀ ਸੂਚੀਬੱਧ ਕਰ ਸਕਦੇ ਹੋ — ਉਹੀ ਵਾਕੰਸ਼, ਉਹੀ ਪਤੇ।</string>
