    <string name="create_phrase_title">Jou herstelfrase</string>
    <string name="create_phrase_body">Skryf hierdie %1$d woorde op papier, vanlyn. Enigiemand met hulle beheer jou fondse.</string>
    <string name="create_passphrase_hint">\'n \"25ste woord\" — \'n ekstra geheim wat nie gestoor word nie. As jy een stel, benodig jy sowel die frase as hierdie om te herstel. Los leeg as jy onseker is.</string>
    <string name="create_ack">Ek het die frase neergeskryf</string>

    <string name="restore_title">Herstel beursie</string>
    <string name="restore_body">Voer jou 12 of 24 woorde in, geskei deur spasies.</string>
    <string name="restore_clone_hint">Nadat dit bygevoeg is, kan jy hierdie beursie ook op %1$s lys vanaf Bestuur beursies — dieselfde frase, dieselfde adresse.</string>
