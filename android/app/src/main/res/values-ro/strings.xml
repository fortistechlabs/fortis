    <string name="gen_title">Adaugă puțină aleatorietate</string>
    <string name="gen_body">Telefonul tău a generat deja un seed sigur. Scutură-l — sau mâzgălește pe zonă — pentru a amesteca entropie suplimentară din senzorii de mișcare și variațiile de timp. Pentru siguranță.</string>
    <string name="gen_words_24">24 de cuvinte</string>
    <string name="gen_words_12">12 cuvinte</string>
    <string name="gen_words_hint">Ambele sunt sigure; 12 se notează mai ușor.</string>
    <string name="gen_pad_hint">scutură sau mâzgălește aici</string>
    <string name="gen_entropy_full">multă entropie suplimentară — seedul de bază este deja sigur</string>
    <string name="gen_entropy_partial">~%1$d biți suplimentari amestecați</string>
    <string name="gen_generate">Generează portofelul</string>

    <string name="create_phrase_title">Fraza ta de recuperare</string>
    <string name="create_phrase_body">Scrie aceste %1$d cuvinte pe hârtie, offline. Oricine le deține îți controlează fondurile.</string>
    <string name="create_passphrase_hint">Un „al 25-lea cuvânt” — un secret suplimentar, care nu este stocat. Dacă setezi unul, ai nevoie atât de frază, cât și de acesta pentru restaurare. Lasă gol dacă nu ești sigur.</string>
    <string name="create_ack">Am notat fraza</string>

    <string name="restore_title">Restaurează portofelul</string>
    <string name="restore_body">Introdu cele 12 sau 24 de cuvinte, separate prin spații.</string>
    <string name="restore_clone_hint">După adăugare poți lista acest portofel și pe %1$s din Gestionează portofelele — aceeași frază, aceleași adrese.</string>
    <string name="action_restore">Restaurează</string>

