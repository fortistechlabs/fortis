    <string name="gen_body">உங்கள் ஃபோன் ஏற்கனவே பாதுகாப்பான சீட்டை உருவாக்கியுள்ளது. இயக்க சென்சார்கள் மற்றும் நேர அசைவுகளிலிருந்து கூடுதல் என்ட்ரோபியைக் கலக்க அதை உலுக்கவும் — அல்லது தட்டில் கிறுக்கவும். முன்னெச்சரிக்கையாக.</string>
    <string name="gen_words_24">24 சொற்கள்</string>
    <string name="gen_words_12">12 சொற்கள்</string>
    <string name="gen_words_hint">இரண்டும் பாதுகாப்பானவை; 12 எழுதுவது எளிது.</string>
    <string name="gen_pad_hint">உலுக்கவும் அல்லது இங்கே கிறுக்கவும்</string>
    <string name="gen_entropy_full">ஏராளமான கூடுதல் என்ட்ரோபி — அடிப்படை சீட் ஏற்கனவே பாதுகாப்பானது</string>
    <string name="gen_entropy_partial">~%1$d கூடுதல் பிட்கள் கலக்கப்பட்டன</string>
