    <string name="create_phrase_title">உங்கள் மீட்பு சொற்றொடர்</string>
    <string name="create_phrase_body">இந்த %1$d சொற்களை காகிதத்தில், ஆஃப்லைனில் எழுதவும். இவற்றை வைத்திருப்பவர் யாரும் உங்கள் நிதியைக் கட்டுப்படுத்துகிறார்.</string>
    <string name="create_passphrase_hint">ஒரு «25வது சொல்» — சேமிக்கப்படாத கூடுதல் ரகசியம். நீங்கள் அமைத்தால், மீட்டமைக்க சொற்றொடரும் இதுவும் இரண்டும் தேவை. உறுதியில்லாவிட்டால் காலியாக விடவும்.</string>
    <string name="create_ack">நான் சொற்றொடரை எழுதிவிட்டேன்</string>

    <string name="restore_title">வாலட்டை மீட்டமை</string>
    <string name="restore_body">உங்கள் 12 அல்லது 24 சொற்களை இடைவெளிகளால் பிரித்து உள்ளிடவும்.</string>
    <string name="restore_clone_hint">சேர்த்த பிறகு «வாலட்களை நிர்வகி» என்பதிலிருந்து இந்த வாலட்டை %1$s இலும் பட்டியலிடலாம் — அதே சொற்றொடர், அதே முகவரிகள்.</string>
