    <string name="gen_title">Shto pak rastësi</string>
    <string name="gen_body">Telefoni yt tashmë ka gjeneruar një farë të sigurt. Shkunde — ose vizato mbi zonën — për të përzier entropi shtesë nga sensorët e lëvizjes dhe luhatjet e kohës. Për siguri.</string>
    <string name="gen_words_24">24 fjalë</string>
    <string name="gen_words_12">12 fjalë</string>
    <string name="gen_words_hint">Të dyja janë të sigurta; 12 shkruhen më lehtë.</string>
    <string name="gen_pad_hint">shkunde, ose vizato këtu</string>
    <string name="gen_entropy_full">shumë entropi shtesë — fara bazë është tashmë e sigurt</string>
    <string name="gen_entropy_partial">u përzien ~%1$d bit shtesë</string>
    <string name="gen_generate">Gjenero portofolin</string>

    <string name="create_phrase_title">Fraza jote e rikuperimit</string>
    <string name="create_phrase_body">Shkruaji këto %1$d fjalë në letër, jashtë linje. Kushdo që i ka, kontrollon fondet e tua.</string>
    <string name="create_passphrase_hint">Një „fjalë e 25-të” — një sekret shtesë, që nuk ruhet. Nëse cakton një, për rikuperim të duhet edhe fraza edhe kjo. Lëre bosh nëse nuk je i sigurt.</string>
    <string name="create_ack">E shënova frazën</string>

    <string name="restore_title">Rikupero portofolin</string>
    <string name="restore_body">Fut 12 ose 24 fjalët e tua, të ndara me hapësira.</string>
    <string name="restore_clone_hint">Pasi ta shtosh, mund ta listosh këtë portofol edhe në %1$s nga „Menaxho portofolët” — e njëjta frazë, të njëjtat adresa.</string>
    <string name="action_restore">Rikupero</string>

