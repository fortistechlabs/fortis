    <string name="gen_title">Thêm chút ngẫu nhiên</string>
    <string name="gen_body">Điện thoại của bạn đã tạo một seed an toàn. Hãy lắc máy — hoặc vẽ nguệch ngoạc lên ô — để trộn thêm entropy từ cảm biến chuyển động và độ trễ thời gian. Cho chắc.</string>
    <string name="gen_words_24">24 từ</string>
    <string name="gen_words_12">12 từ</string>
    <string name="gen_words_hint">Cả hai đều an toàn; 12 từ dễ ghi lại hơn.</string>
    <string name="gen_pad_hint">lắc, hoặc vẽ nguệch ngoạc ở đây</string>
    <string name="gen_entropy_full">có nhiều entropy bổ sung — seed cơ bản đã an toàn</string>
    <string name="gen_entropy_partial">đã trộn thêm ~%1$d bit</string>
    <string name="gen_generate">Tạo ví</string>

    <string name="create_phrase_title">Cụm từ khôi phục của bạn</string>
    <string name="create_phrase_body">Ghi %1$d từ này ra giấy, ngoại tuyến. Bất kỳ ai có chúng đều kiểm soát tiền của bạn.</string>
    <string name="create_passphrase_hint">Một \"từ thứ 25\" — bí mật bổ sung, không được lưu. Nếu đặt, bạn cần cả cụm từ và cái này để khôi phục. Để trống nếu không chắc.</string>
    <string name="create_ack">Tôi đã ghi lại cụm từ</string>

    <string name="restore_title">Khôi phục ví</string>
    <string name="restore_body">Nhập 12 hoặc 24 từ của bạn, cách nhau bằng dấu cách.</string>
    <string name="restore_clone_hint">Sau khi thêm, bạn cũng có thể liệt kê ví này trên %1$s từ Quản lý ví — cùng cụm từ, cùng địa chỉ.</string>
