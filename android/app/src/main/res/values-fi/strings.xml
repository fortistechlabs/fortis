    <string name="gen_title">Lisää hieman satunnaisuutta</string>
    <string name="gen_body">Puhelimesi loi jo turvallisen siemenen. Ravista sitä — tai piirrä alueelle — jotta liikeantureista ja ajoitusvaihtelusta saadaan lisää entropiaa. Varmuuden vuoksi.</string>
    <string name="gen_words_24">24 sanaa</string>
    <string name="gen_words_12">12 sanaa</string>
    <string name="gen_words_hint">Molemmat ovat turvallisia; 12 on helpompi kirjoittaa muistiin.</string>
    <string name="gen_pad_hint">ravista tai piirrä tähän</string>
    <string name="gen_entropy_full">runsaasti lisäentropiaa — perussiemen on jo turvallinen</string>
    <string name="gen_entropy_partial">~%1$d lisäbittiä sekoitettu</string>
    <string name="gen_generate">Luo lompakko</string>

    <string name="create_phrase_title">Palautuslauseesi</string>
    <string name="create_phrase_body">Kirjoita nämä %1$d sanaa paperille, ilman verkkoyhteyttä. Kuka tahansa, jolla ne on, hallitsee varojasi.</string>
    <string name="create_passphrase_hint">\"25. sana\" — ylimääräinen salaisuus, jota ei tallenneta. Jos asetat sellaisen, tarvitset palautukseen sekä lauseen että tämän. Jätä tyhjäksi, jos et ole varma.</string>
    <string name="create_ack">Olen kirjoittanut lauseen muistiin</string>

    <string name="restore_title">Palauta lompakko</string>
    <string name="restore_body">Syötä 12 tai 24 sanaasi välilyönnein erotettuina.</string>
    <string name="restore_clone_hint">Kun se on lisätty, voit listata tämän lompakon myös palvelussa %1$s Hallitse lompakoita -näkymästä — sama lause, samat osoitteet.</string>
