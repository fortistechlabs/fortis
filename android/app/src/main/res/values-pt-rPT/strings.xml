    <string name="create_phrase_title">A sua frase de recuperação</string>
    <string name="create_phrase_body">Escreva estas %1$d palavras em papel, offline. Quem as tiver controla os seus fundos.</string>
    <string name="create_passphrase_hint">Uma \"25.ª palavra\" — um segredo adicional, não guardado. Se definir uma, precisa da frase e desta para restaurar. Deixe em branco se tiver dúvidas.</string>
    <string name="create_ack">Anotei a frase</string>

    <string name="restore_title">Restaurar carteira</string>
    <string name="restore_body">Introduza as suas 12 ou 24 palavras, separadas por espaços.</string>
    <string name="restore_clone_hint">Depois de adicionada, também pode listar esta carteira em %1$s a partir de Gerir carteiras — mesma frase, mesmos endereços.</string>
