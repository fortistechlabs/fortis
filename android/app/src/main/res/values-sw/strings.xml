    <string name="gen_words_12">Maneno 12</string>
    <string name="gen_words_hint">Zote mbili ni salama; 12 ni rahisi kuandika.</string>
    <string name="gen_pad_hint">tikisa, au chora hapa</string>
    <string name="gen_entropy_full">entropia ya ziada tele — mbegu ya msingi tayari ni salama</string>
    <string name="gen_entropy_partial">biti za ziada ~%1$d zimechanganywa</string>
    <string name="gen_generate">Zalisha pochi</string>

    <string name="create_phrase_title">Kifungu chako cha kurejesha</string>
    <string name="create_phrase_body">Andika maneno haya %1$d kwenye karatasi, nje ya mtandao. Yeyote aliye nayo anadhibiti fedha zako.</string>
    <string name="create_passphrase_hint">\"Neno la 25\" — siri ya ziada isiyohifadhiwa. Ukiliweka, unahitaji kifungu na hili ili kurejesha. Acha wazi ikiwa huna uhakika.</string>
    <string name="create_ack">Nimeandika kifungu</string>

    <string name="restore_title">Rejesha pochi</string>
    <string name="restore_body">Weka maneno yako 12 au 24, yakitenganishwa kwa nafasi.</string>
    <string name="restore_clone_hint">Baada ya kuongezwa unaweza pia kuorodhesha pochi hii kwenye %1$s kutoka Dhibiti pochi — kifungu kilekile, anwani zilezile.</string>
