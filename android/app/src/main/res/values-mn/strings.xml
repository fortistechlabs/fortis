    <string name="create_phrase_title">Таны сэргээх хэллэг</string>
    <string name="create_phrase_body">Эдгээр %1$d үгийг цаасан дээр, офлайнаар бичээрэй. Эдгээрийг эзэмшсэн хэн ч таны хөрөнгийг хянадаг.</string>
    <string name="create_passphrase_hint">"25 дахь үг" — хадгалагддаггүй нэмэлт нууц. Хэрэв та тохируулбал сэргээхийн тулд хэллэг болон энэ хоёулаа хэрэгтэй. Эргэлзэж байвал хоосон орхи.</string>
    <string name="create_ack">Би хэллэгийг тэмдэглэсэн</string>

