    <string name="gen_title">Engade algo de aleatoriedade</string>
    <string name="gen_body">O teu teléfono xa xerou unha semente segura. Axítao — ou garabatea no panel — para engadir entropía extra dos sensores de movemento e das variacións de tempo. Por precaución.</string>
    <string name="gen_words_24">24 palabras</string>
    <string name="gen_words_12">12 palabras</string>
    <string name="gen_words_hint">Ambas son seguras; 12 é máis doado de anotar.</string>
    <string name="gen_pad_hint">axita ou garabatea aquí</string>
    <string name="gen_entropy_full">entropía extra de sobra — a semente base xa é segura</string>
    <string name="gen_entropy_partial">~%1$d bits extra engadidos</string>
    <string name="gen_generate">Xerar carteira</string>

    <string name="create_phrase_title">A túa frase de recuperación</string>
    <string name="create_phrase_body">Escribe estas %1$d palabras en papel, sen conexión. Quen as teña controla os teus fondos.</string>
    <string name="create_passphrase_hint">Unha \"25ª palabra\" — un segredo adicional, non gardado. Se pos unha, precisas tanto a frase como isto para restaurar. Deixa en branco se non estás seguro.</string>
    <string name="create_ack">Anotei a frase</string>

    <string name="restore_title">Restaurar carteira</string>
    <string name="restore_body">Introduce as túas 12 ou 24 palabras, separadas por espazos.</string>
    <string name="restore_clone_hint">Despois de engadila tamén podes listar esta carteira en %1$s desde Xestionar carteiras — a mesma frase, os mesmos enderezos.</string>
    <string name="action_restore">Restaurar</string>

