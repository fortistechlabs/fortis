    <string name="gen_title">Додајте мало насумичности</string>
    <string name="gen_body">Ваш телефон је већ генерисао безбедно семе. Протресите га — или шкработите по пољу — да умешате додатну ентропију из сензора покрета и временских одступања. За сваки случај.</string>
    <string name="gen_words_24">24 речи</string>
    <string name="gen_words_12">12 речи</string>
    <string name="gen_words_hint">Обе су безбедне; 12 је лакше записати.</string>
    <string name="gen_pad_hint">протресите или шкработите овде</string>
    <string name="gen_entropy_full">довољно додатне ентропије — основно семе је већ безбедно</string>
    <string name="gen_entropy_partial">умешано ~%1$d додатних битова</string>
    <string name="gen_generate">Генериши новчаник</string>

    <string name="create_phrase_title">Ваша фраза за опоравак</string>
    <string name="create_phrase_body">Запишите ових %1$d речи на папир, ван мреже. Свако ко их има управља вашим средствима.</string>
    <string name="create_passphrase_hint">„25. реч” — додатна тајна која се не чува. Ако је поставите, за опоравак вам требају и фраза и она. Оставите празно ако нисте сигурни.</string>
    <string name="create_ack">Записао/ла сам фразу</string>

    <string name="restore_title">Опорави новчаник</string>
    <string name="restore_body">Унесите својих 12 или 24 речи, раздвојених размацима.</string>
    <string name="restore_clone_hint">Након додавања овај новчаник можете навести и на %1$s преко Управљања новчаницима — иста фраза, исте адресе.</string>
