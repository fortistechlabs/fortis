    <string name="create_phrase_title">Din gendannelsessætning</string>
    <string name="create_phrase_body">Skriv disse %1$d ord ned på papir, offline. Enhver med dem kontrollerer dine midler.</string>
    <string name="create_passphrase_hint">Et \"25. ord\" — en ekstra hemmelighed, der ikke gemmes. Sætter du en, skal du bruge både sætningen og denne for at gendanne. Lad stå tomt, hvis du er i tvivl.</string>
    <string name="create_ack">Jeg har skrevet sætningen ned</string>

    <string name="restore_title">Gendan tegnebog</string>
    <string name="restore_body">Indtast dine 12 eller 24 ord adskilt af mellemrum.</string>
    <string name="restore_clone_hint">Når den er tilføjet, kan du også vise denne tegnebog på %1$s via Administrer tegnebøger — samme sætning, samme adresser.</string>
