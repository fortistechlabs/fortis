    <string name="create_passphrase_hint">Sebuah \"kata ke-25\" — rahasia ekstra yang tidak disimpan. Jika Anda mengaturnya, Anda memerlukan frasa dan ini untuk memulihkan. Biarkan kosong jika ragu.</string>
    <string name="create_ack">Saya sudah mencatat frasanya</string>

