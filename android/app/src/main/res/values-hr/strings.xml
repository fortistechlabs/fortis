    <string name="gen_title">Dodajte malo nasumičnosti</string>
    <string name="gen_body">Vaš je telefon već generirao sigurno sjeme. Protresite ga — ili črčkajte po polju — kako biste umiješali dodatnu entropiju iz senzora pokreta i vremenskih odstupanja. Za svaki slučaj.</string>
    <string name="gen_words_24">24 riječi</string>
    <string name="gen_words_12">12 riječi</string>
    <string name="gen_words_hint">Obje su sigurne; 12 je lakše zapisati.</string>
    <string name="gen_pad_hint">protresite ili črčkajte ovdje</string>
    <string name="gen_entropy_full">obilje dodatne entropije — osnovno sjeme već je sigurno</string>
    <string name="gen_entropy_partial">umiješano ~%1$d dodatnih bitova</string>
    <string name="gen_generate">Generiraj novčanik</string>

    <string name="create_phrase_title">Vaša fraza za oporavak</string>
    <string name="create_phrase_body">Zapišite ovih %1$d riječi na papir, izvan mreže. Tko god ih ima, kontrolira vaša sredstva.</string>
    <string name="create_passphrase_hint">„25. riječ” — dodatna tajna koja se ne pohranjuje. Ako je postavite, za oporavak trebate i frazu i nju. Ako niste sigurni, ostavite prazno.</string>
    <string name="create_ack">Zapisao/la sam frazu</string>

    <string name="restore_title">Oporavi novčanik</string>
    <string name="restore_body">Unesite svojih 12 ili 24 riječi odvojenih razmacima.</string>
    <string name="restore_clone_hint">Nakon dodavanja ovaj novčanik možete navesti i na %1$s putem Upravljanja novčanicima — ista fraza, iste adrese.</string>
    <string name="action_restore">Oporavi</string>

