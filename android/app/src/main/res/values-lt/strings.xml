    <string name="gen_words_hint">Abi saugios; 12 lengviau užsirašyti.</string>
    <string name="gen_pad_hint">pakratykite arba pieškite čia</string>
    <string name="gen_entropy_full">daug papildomos entropijos — bazinė sėkla jau saugi</string>
