    <string name="create_phrase_title">Jūsų atkūrimo frazė</string>
    <string name="create_phrase_body">Užrašykite šiuos %1$d žodžius ant popieriaus, neprisijungę. Bet kas, kas juos turi, valdo jūsų lėšas.</string>
    <string name="create_passphrase_hint">„25-asis žodis“ — papildoma paslaptis, kuri nesaugoma. Jei ją nustatysite, atkūrimui reikės ir frazės, ir jos. Jei nesate tikri, palikite tuščią.</string>
    <string name="create_ack">Užsirašiau frazę</string>

