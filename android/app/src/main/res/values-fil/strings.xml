    <string name="gen_title">Magdagdag ng randomness</string>
    <string name="gen_body">Gumawa na ang iyong telepono ng secure na seed. Iyugyog ito — o mag-scribble sa pad — para makapaghalo ng dagdag na entropy mula sa mga motion sensor at timing jitter. Para sigurado.</string>
    <string name="gen_words_24">24 na salita</string>
    <string name="gen_words_12">12 salita</string>
    <string name="gen_words_hint">Parehong secure; mas madaling isulat ang 12.</string>
    <string name="gen_pad_hint">iyugyog, o mag-scribble dito</string>
    <string name="gen_entropy_full">sagana sa dagdag na entropy — secure na ang base seed</string>
    <string name="gen_entropy_partial">~%1$d dagdag na bit ang naihalo</string>
    <string name="gen_generate">Gumawa ng wallet</string>

    <string name="create_phrase_title">Ang iyong recovery phrase</string>
    <string name="create_phrase_body">Isulat ang %1$d salitang ito sa papel, offline. Kontrolado ng sinumang may hawak nito ang iyong pondo.</string>
    <string name="create_passphrase_hint">Isang \"ika-25 salita\" — dagdag na sekreto na hindi iniimbak. Kung magtatakda ka, kailangan mo ang phrase at ito para makapag-restore. Iwang blangko kung hindi sigurado.</string>
    <string name="create_ack">Naisulat ko na ang phrase</string>

    <string name="restore_title">I-restore ang wallet</string>
    <string name="restore_body">Ilagay ang iyong 12 o 24 na salita, na pinaghihiwalay ng espasyo.</string>
    <string name="restore_clone_hint">Pagkatapos maidagdag, maaari mo ring ilista ang wallet na ito sa %1$s mula sa Pamahalaan ang mga wallet — parehong phrase, parehong address.</string>
