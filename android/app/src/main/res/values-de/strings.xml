    <string name="gen_title">Zusätzlichen Zufall hinzufügen</string>
    <string name="gen_body">Dein Telefon hat bereits einen sicheren Seed erzeugt. Schüttle es – oder kritzle auf dem Feld – um zusätzliche Entropie aus den Bewegungssensoren und dem Timing-Jitter einzubringen. Doppelt hält besser.</string>
    <string name="gen_words_24">24 Wörter</string>
    <string name="gen_words_12">12 Wörter</string>
    <string name="gen_words_hint">Beide sind sicher; 12 lassen sich leichter aufschreiben.</string>
    <string name="gen_pad_hint">schütteln oder hier kritzeln</string>
    <string name="gen_entropy_full">reichlich zusätzliche Entropie – der Basis-Seed ist bereits sicher</string>
    <string name="gen_entropy_partial">~%1$d zusätzliche Bits eingebracht</string>
    <string name="gen_generate">Wallet erzeugen</string>

    <string name="create_phrase_title">Deine Wiederherstellungsphrase</string>
    <string name="create_phrase_body">Schreibe diese %1$d Wörter offline auf Papier. Wer sie hat, kontrolliert dein Guthaben.</string>
    <string name="create_passphrase_hint">Ein \"25. Wort\" – ein zusätzliches Geheimnis, das nicht gespeichert wird. Wenn du eines festlegst, brauchst du zum Wiederherstellen sowohl die Phrase als auch dieses. Im Zweifel leer lassen.</string>
    <string name="create_ack">Ich habe die Phrase aufgeschrieben</string>

    <string name="restore_title">Wallet wiederherstellen</string>
    <string name="restore_body">Gib deine 12 oder 24 Wörter durch Leerzeichen getrennt ein.</string>
    <string name="restore_clone_hint">Nach dem Hinzufügen kannst du diese Wallet unter „Wallets verwalten“ auch auf %1$s führen – gleiche Phrase, gleiche Adressen.</string>
    <string name="action_restore">Wiederherstellen</string>

