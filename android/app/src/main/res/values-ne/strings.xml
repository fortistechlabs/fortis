    <string name="create_phrase_title">तपाईंको रिकभरी वाक्यांश</string>
    <string name="create_phrase_body">यी %1$d शब्द कागजमा, अफलाइन लेख्नुहोस्। यी भएको जोसुकैले तपाईंको रकम नियन्त्रण गर्छ।</string>
    <string name="create_passphrase_hint">एउटा «25औं शब्द» — भण्डारण नगरिने थप गोप्य कुरा। तपाईंले सेट गर्नुभयो भने पुनर्स्थापनाका लागि वाक्यांश र यो दुवै चाहिन्छ। निश्चित नभए खाली छोड्नुहोस्।</string>
    <string name="create_ack">मैले वाक्यांश लेखेँ</string>

    <string name="restore_title">वालेट पुनर्स्थापना गर्नुहोस्</string>
    <string name="restore_body">तपाईंका 12 वा 24 शब्द, स्पेसले छुट्याएर प्रविष्ट गर्नुहोस्।</string>
    <string name="restore_clone_hint">थपेपछि «वालेट व्यवस्थापन गर्नुहोस्»बाट तपाईंले यो वालेटलाई %1$s मा पनि सूचीबद्ध गर्न सक्नुहुन्छ — उही वाक्यांश, उही ठेगानाहरू।</string>
