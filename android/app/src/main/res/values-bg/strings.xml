    <string name="gen_title">Добавете малко случайност</string>
    <string name="gen_body">Телефонът ви вече генерира сигурен seed. Разклатете го — или драскайте върху полето — за да добавите допълнителна ентропия от сензорите за движение и колебанията във времето. За всеки случай.</string>
    <string name="gen_words_24">24 думи</string>
    <string name="gen_words_12">12 думи</string>
    <string name="gen_words_hint">И двете са сигурни; 12 се записват по-лесно.</string>
    <string name="gen_pad_hint">разклатете или драскайте тук</string>
    <string name="gen_entropy_full">достатъчно допълнителна ентропия — базовият seed вече е сигурен</string>
    <string name="gen_entropy_partial">добавени ~%1$d допълнителни бита</string>
    <string name="gen_generate">Генерирай портфейл</string>

    <string name="create_phrase_title">Вашата фраза за възстановяване</string>
    <string name="create_phrase_body">Запишете тези %1$d думи на хартия, офлайн. Всеки, който ги притежава, контролира средствата ви.</string>
    <string name="create_passphrase_hint">„25-а дума“ — допълнителна тайна, която не се съхранява. Ако зададете такава, за възстановяване ви трябват и фразата, и тя. Оставете празно, ако не сте сигурни.</string>
    <string name="create_ack">Записах фразата</string>

    <string name="restore_title">Възстанови портфейл</string>
    <string name="restore_body">Въведете своите 12 или 24 думи, разделени с интервали.</string>
    <string name="restore_clone_hint">След като бъде добавен, можете да включите този портфейл и в %1$s от „Управление на портфейли“ — същата фраза, същите адреси.</string>
    <string name="action_restore">Възстанови</string>

