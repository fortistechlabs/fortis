    <string name="gen_title">Gehitu ausazkotasun pixka bat</string>
    <string name="gen_body">Zure telefonoak jada sortu du hazi seguru bat. Astindu ezazu — edo marraztu eremuan — mugimendu-sentsoreetatik eta denbora-aldaketetatik entropia gehigarria nahasteko. Segurtasunerako.</string>
    <string name="gen_words_24">24 hitz</string>
    <string name="gen_words_12">12 hitz</string>
    <string name="gen_words_hint">Biak seguruak dira; 12 errazago idazten dira.</string>
    <string name="gen_pad_hint">astindu edo marraztu hemen</string>
    <string name="gen_entropy_full">entropia gehigarri ugari — oinarrizko hazia jada segurua da</string>
    <string name="gen_entropy_partial">~%1$d bit gehigarri nahastuta</string>
    <string name="gen_generate">Sortu diru-zorroa</string>

    <string name="create_phrase_title">Zure berreskuratze-esaldia</string>
    <string name="create_phrase_body">Idatzi %1$d hitz hauek paperean, lineaz kanpo. Dituenak zure funtsak kontrolatzen ditu.</string>
    <string name="create_passphrase_hint">"25. hitz" bat — gordetzen ez den sekretu gehigarri bat. Bat ezartzen baduzu, berreskuratzeko esaldia eta hau behar dituzu. Utzi hutsik ziur ez bazaude.</string>
    <string name="create_ack">Esaldia idatzi dut</string>

    <string name="restore_title">Berreskuratu diru-zorroa</string>
    <string name="restore_body">Sartu zure 12 edo 24 hitzak, zuriunez bereizita.</string>
    <string name="restore_clone_hint">Gehitu ondoren, diru-zorro hau %1$s zerbitzuan ere zerrenda dezakezu Kudeatu diru-zorroak atalean — esaldi bera, helbide berak.</string>
