    <string name="create_phrase_title">Tu frase de recuperación</string>
    <string name="create_phrase_body">Escribe estas %1$d palabras en papel, sin conexión. Cualquiera que las tenga controla tus fondos.</string>
    <string name="create_passphrase_hint">Una \"25.ª palabra\" — un secreto adicional que no se guarda. Si estableces una, necesitas tanto la frase como esto para restaurar. Déjalo en blanco si no estás seguro.</string>
    <string name="create_ack">Anoté la frase</string>

    <string name="restore_title">Restaurar billetera</string>
    <string name="restore_body">Ingresa tus 12 o 24 palabras, separadas por espacios.</string>
    <string name="restore_clone_hint">Después de agregarla, también puedes listar esta billetera en %1$s desde Administrar billeteras — la misma frase, las mismas direcciones.</string>
