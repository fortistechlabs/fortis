# /etc/systemd/system/fortis-edge.service
# Public front (via the Cloudflare tunnel → localhost:8098) for both indexes.
# The BTC source lives in /etc/fortis/edge.env (BTC_ARGS) so it can move from a
# public Esplora to the local fortis-btc-index once that has synced.

[Unit]
Description=fortis-edge (public wallet backend)
After=network-online.target fortis-xbt-index.service fortis-btc-index.service
Wants=network-online.target
PartOf=bitcoin-core.service

[Service]
Type=simple
User=fortis
Group=fortis
SupplementaryGroups=bitcoin-core
EnvironmentFile=/etc/fortis/edge.env
ExecStart=/usr/local/bin/fortis-edge \
  --bind 127.0.0.1:8098 \
  --xbt-upstream http://127.0.0.1:8094 \
  $BTC_ARGS \
  --btc-rpc-url http://127.0.0.1:8332 \
  --btc-rpc-cookie /var/lib/bitcoin-core/.cookie \
  --btc-price-url https://neoxa.exchange/api/exchange/ticker/BTC_USDC \
  --xbt-price-url https://neoxa.exchange/api/exchange/ticker/BTCB2_USDC \
  --fx-url https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml \
  --secret-file /var/lib/fortis/edge/fortis-edge.secret \
  --cache-dir /var/lib/fortis/edge/cache \
  --btc-history-dir /var/lib/fortis/edge/btc-history \
  --btc-scan-cache-dir /var/lib/fortis/edge/btc-scan-cache \
  --require-token \
  --trust-forwarded-for \
  --allow-origin $ALLOW_ORIGIN \
  --crash-log /var/log/fortis/crashes.ndjson \
  $EXTRA_ARGS
Restart=on-failure
RestartSec=5
StateDirectory=fortis fortis/edge
LogsDirectory=fortis
ReadWritePaths=/var/lib/fortis /var/log/fortis
# Sandbox (check with `systemd-analyze security <unit>`): files owner-only,
# no privileges, devices, kernel knobs or namespaces, only IP and Unix
# sockets and the usual service system calls (others fail with EPERM).
UMask=0077
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LogsDirectoryMode=0700
# Peaks near 60 MB; the cap only stops a runaway.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
