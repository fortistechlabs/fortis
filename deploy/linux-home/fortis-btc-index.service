# /etc/systemd/system/fortis-btc-index.service
# BTC address index over the local Bitcoin Core node (RPC :8332). Serves the
# Esplora subset fortis-edge uses as its --btc-upstream (with --btc-upstream-scan).
#
# Cookie auth: the fortis user is in the bitcoin-core group. PartOf= restarts
# this unit whenever Core restarts, so it re-reads the rotated .cookie.

[Unit]
Description=fortis-index (BTC, over Bitcoin Core)
After=network-online.target bitcoin-core.service
Wants=network-online.target
Requires=bitcoin-core.service
PartOf=bitcoin-core.service

[Service]
Type=simple
User=fortis
Group=fortis
SupplementaryGroups=bitcoin-core
ExecStart=/usr/local/bin/fortis-index \
  --network mainnet \
  --rpc-url http://127.0.0.1:8332 \
  --cookie-file /var/lib/bitcoin-core/.cookie \
  --db /var/lib/fortis/btc-index-v2 \
  --bind 127.0.0.1:8095
Restart=on-failure
RestartSec=10
# Exit 2 = fatal (wrong chain or schema in --db, reorg deeper than the undo
# window): restarting cannot fix it, so don't loop.
RestartPreventExitStatus=2
# SIGTERM finishes the current batch and flushes RocksDB before exiting.
TimeoutStopSec=120
StateDirectory=fortis
ReadWritePaths=/var/lib/fortis
# Sandbox (check with `systemd-analyze security <unit>`): files owner-only,
# no privileges, devices, kernel knobs or namespaces, only IP and Unix
# sockets and the usual service system calls (others fail with EPERM).
UMask=0077
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# It talks to the local node and answers the local edge: nothing else.
IPAddressAllow=localhost
IPAddressDeny=any
# Peaks near 4 GB while syncing.
MemoryMax=10G

[Install]
WantedBy=bitcoin-core.service
