# /etc/fortis/edge.env — read by fortis-edge.service. Restart the edge after editing.

# While fortis-btc-index is doing its first sync, serve BTC from a public Esplora:
BTC_ARGS=--btc-upstream https://blockstream.info/api --btc-upstream-rate 5
# Once `curl -s 127.0.0.1:8095/blocks/tip/height` matches `core-cli getblockcount`,
# switch to your own node (no Haskoin, no public explorer) — comment the line above,
# uncomment this one:
#BTC_ARGS=--btc-upstream http://127.0.0.1:8095 --btc-upstream-scan --btc-upstream-rate 0

# CORS origin(s) — match what the Windows edge used.
ALLOW_ORIGIN=*

# Anything else from the Windows edge's args (e.g. --service-fee-address ...).
EXTRA_ARGS=
