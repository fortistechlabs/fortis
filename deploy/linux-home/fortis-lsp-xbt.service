# /etc/systemd/system/fortis-lsp-xbt.service
# Lightning Service Provider for XBT (the same fortis-lsp binary as fortis-lsp.service,
# config chain = "xbt"). Its chain source is the XBT index's Esplora API
# (http://127.0.0.1:8094), so it has no bitcoin-core dependency. Listens on :9835/TCP
# (P2P, announced as lsp.fortistechlabs.com:9835 through the relay) and
# 127.0.0.1:9746 (Prometheus /metrics, /info and the admin endpoints).

[Unit]
Description=fortis-lsp (Lightning Service Provider, XBT)
After=network-online.target fortis-xbt-index.service
Wants=network-online.target fortis-xbt-index.service

[Service]
Type=simple
User=fortis
Group=fortis
ExecStart=/usr/bin/env /usr/local/bin/fortis-lsp --config /etc/fortis/lsp-xbt.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=fortis fortis/lsp-xbt
ReadWritePaths=/var/lib/fortis
# Sandbox (check with `systemd-analyze security <unit>`): files owner-only,
# no privileges, devices, kernel knobs or namespaces, only IP and Unix
# sockets and the usual service system calls (others fail with EPERM).
UMask=0077
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=1G

[Install]
WantedBy=multi-user.target
