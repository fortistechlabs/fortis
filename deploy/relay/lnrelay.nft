# /etc/wireguard/lnrelay.nft on the VPS: forward TCP 9735 to the home LSP.
table ip lnrelay {
  chain pre {
    type nat hook prerouting priority -100;
    tcp dport 9735 dnat to 10.8.0.2:9735
  }
  chain post {
    type nat hook postrouting priority 100;
    ip daddr 10.8.0.2 tcp dport 9735 masquerade
  }
}
