# Copy to deploy/.env and fill in.

NETWORK=mainnet

# --- XBT node (Bitcoin Knots BLAKE2b) RPC ---------------------------------
# Add an rpcauth line to the Knots bitcoin.conf (generate with the rpcauth.py
# helper shipped with Bitcoin Core), then put the matching user:password here:
#   rpcauth=fortis:<salt>$<hash>
XBT_RPC_URL=http://host.docker.internal:8332
XBT_RPC_AUTH=fortis:CHANGE_ME

# --- BTC upstream (an Esplora API) ----------------------------------------
# blockstream.info is the most permissive; mempool.space also works. Or point
# at a `fortisd --esplora-proxy` you run.
BTC_UPSTREAM=https://blockstream.info/api

# --- edge ---------------------------------------------------------------------
# Lock this to your wallet's origin(s) in production, e.g. https://wallet.fortis.example
ALLOW_ORIGIN=*
RATE_PER_MIN=120
RATE_BURST=60
