# fortis-lsp configuration (/etc/fortis/lsp.toml). Every key is optional;
# the value shown is the default. Unknown keys are an error.
# No secrets in this file: the bitcoind RPC password lives in
# rpc_password_file, and the LSPS2 token (if any) is set here by the operator
# but never logged or exposed on the metrics listener.

# bitcoin (mainnet) | testnet | signet | regtest
network = "bitcoin"

# Lightning P2P listen address (the app reaches it via the edge's /ln/info).
listen = "0.0.0.0:9735"

# Chain source: Bitcoin Core RPC, host:port.
bitcoind_rpc = "127.0.0.1:8332"
rpc_user = "fortis-lsp"
# First line of this file is the RPC password (mode 0600, owned by the
# service user).
rpc_password_file = "/etc/fortis/lsp-rpc-password"

# Absolute path. Holds the node seed (keys_seed: generated on first start,
# mode 0400, keeps the node id across restarts -- back it up), ldk-node's
# SQLite store and logs (logs/). Created 0700 if missing; refused if
# group/other can access it.
data_dir = "/var/lib/fortis-lsp"

# Channel-open fee for a JIT channel: open_fee_ppm of the payment (10 000 =
# 1 %; at most 100 000 = 10 %), but at least open_fee_min_sat. The floor is an
# operator choice: keep it near twice the next-block fee of a channel-open
# transaction and revisit it when fees move.
open_fee_ppm = 10000
open_fee_min_sat = 1000

# Payment sizes the LSP accepts for a JIT channel (outer bounds; max
# defaults to channel_max_sat in msat). The LSP narrows them so every JIT
# channel stays within channel_min_sat..channel_max_sat -- with these
# defaults it accepts 51 000..250 000 sat -- and publishes the narrowed
# bounds (GET /info, the stderr line at start). A config that leaves no
# payment size is refused.
min_payment_size_msat = 10000000
max_payment_size_msat = 500000000

# JIT channel size = (payment - open fee) x channel_size_factor (1.0 to 10.0).
channel_size_factor = 2.0

# JIT channel size bounds, enforced through the payment bounds above.
channel_min_sat = 100000
channel_max_sat = 500000

# LSPS2 token clients must present. Omit for none.
# token = "..."

# Warn (stderr, checked every 60 s) while on-chain funds are below this. 0 = off.
low_liquidity_sat = 2000000

# Prometheus GET /metrics and GET /info. Loopback only unless
# allow_public_metrics = true.
metrics_listen = "127.0.0.1:9736"
allow_public_metrics = false
